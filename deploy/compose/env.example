# SPDX-License-Identifier: Apache-2.0
# Copy to .env and fill in every value. Nothing here is a working default.
MCP_RE_VERSION=0.19.0
# This server's identity and the URI a signed request must name; they must equal what your
# clients sign. The trust domain must agree with the identities in the trust document you mount.
MCP_RE_AUDIENCE=did:web:mcp-re.example.net
MCP_RE_TARGET_URI=https://mcp-re-proxy:8600/mcp
MCP_RE_TRUST_DOMAIN=mcp-re-proxy
MCP_RE_SERVER_KEY_ID=server-key-1
# Coordinate with verifiers: advancing it invalidates every credential issued under the last.
MCP_RE_TRUST_EPOCH=epoch-1
# Your Streamable-HTTP MCP backend, reachable from the proxy container.
MCP_RE_INNER_URL=http://host.docker.internal:9000/mcp
# Generate one: openssl rand -hex 24
REDIS_PASSWORD=
