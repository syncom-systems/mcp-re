load("//bazel:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

# ADR-MCPRE-066 §2.1: the source tree, exposed so the conformance audit-vocabulary guard can
# MEASURE which files decide what an `mcp-re.*` verdict token says, rather than reading a
# hand-maintained list of producers. The sentinel names the tree; the guard walks it.
filegroup(
    name = "guard_src_files",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

# The one adapter both SDK bindings share over mcp-re-client-core: typed signing and
# verification arguments, the verdict and the binding refusal. No host language is linked,
# so the PyO3 and napi bindings each marshal into it.
nt_rust_library(
    name = "mcp_re_binding_core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mcp_re_binding_core",
    edition = "2021",
    deps = [
        "//mcp-re-client-core:mcp_re_client_core",
        "//mcp-re-core:mcp_re_core",
        "@crates_mcp_re//:serde_json",
    ],
)

# The adapter's battery: device signatures byte-identical to software ones and a device
# answer that is not 64 octets refused, the refusal order and messages both hosts raise,
# the pinned-identity checks before any evidence, and the verdict projection keeping an
# unstated execution member absent. Hermetic.
nt_rust_test(
    name = "mcp_re_binding_core_test",
    crate = ":mcp_re_binding_core",
    edition = "2021",
    deps = [],
)
